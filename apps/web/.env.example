# ==============================================================================
# Supabase Configuration
# ==============================================================================
# 1. Supabase Project Credentials (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Supabase Database Connection URI (from Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ==============================================================================
# AI & LLM Engine (Groq)
# ==============================================================================
# Free API key from https://groq.com/
GROQ_API_KEY=
GROQ_MODEL_NAME=qwen/qwen-2.5-72b-instruct

# ==============================================================================
# Application Security & Encryption
# ==============================================================================
ENCRYPTION_KEY=a_very_secure_secret_key_32_bytes_long!!
NEXT_PUBLIC_APP_PASSWORD=ahmad-beyond-limits-123

# ==============================================================================
# Application Ports & Endpoints
# ==============================================================================
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_TYPING_URL=http://localhost:3001
