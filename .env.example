# WriteAbout Environment Variables

# App Password (must start with NEXT_PUBLIC_ to be accessible in the client component)
# The hardcoded password used to access the application
NEXT_PUBLIC_APP_PASSWORD=ahmad-beyond-limits-123

# Cerebras API Key (used for backend AI analysis if needed, though currently user enters it on the frontend)
CEREBRAS_API_KEY=

# Your Postgres Database Connection String
# (If hosting on Vercel, install Neon Postgres from the Marketplace and paste the URL here)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
