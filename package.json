{
  "name": "writeabout-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=web",
    "dev:typing": "turbo dev --filter=typing",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate --filter=@writeabout/db",
    "db:migrate": "turbo db:migrate --filter=@writeabout/db",
    "db:push": "turbo db:push --filter=@writeabout/db",
    "db:seed": "turbo db:seed --filter=@writeabout/db"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5"
  }
}
